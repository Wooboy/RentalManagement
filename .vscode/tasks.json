{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/src/frontend/rental-manager-web"
      },
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/src/frontend/rental-manager-web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*"
        }
      }
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/src/frontend/rental-manager-web"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "backend: restore",
      "type": "process",
      "command": "dotnet",
      "args": [
        "restore",
        "src/backend/RentalManager.Api/RentalManager.Api.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "backend: run",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/backend/RentalManager.Api/RentalManager.Api.csproj"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "csharp",
        "pattern": {
          "regexp": "^(.+?)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+([A-Z0-9]+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Now listening on:|Application started\\."
        }
      }
    },
    {
      "label": "backend: build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "src/backend/RentalManager.Api/RentalManager.Api.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "backend: ef database update",
      "type": "process",
      "command": "dotnet",
      "args": [
        "ef",
        "database",
        "update",
        "--project",
        "src/backend/RentalManager.Api/RentalManager.Api.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: all",
      "dependsOn": [
        "backend: build",
        "frontend: build"
      ],
      "dependsOrder": "sequence",
      "group": "build"
    },
    {
      "label": "dev: start all",
      "dependsOn": [
        "backend: run",
        "frontend: dev"
      ],
      "dependsOrder": "parallel"
    }
  ]
}
