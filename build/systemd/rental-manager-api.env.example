# 租屋管理系統 API 環境變數（systemd EnvironmentFile）
# 部署步驟：docs/DEPLOYMENT_UBUNTU.md
#
# 格式：KEY=VALUE 一行一個，不需引號；檔案必須是 LF 換行。
# 雙底線 __ 對應 appsettings.json 的階層（Storage__Root = Storage:Root），
# 會覆寫 appsettings.json 的同名設定。

# ── 執行環境 ──────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
# 只聽本機；埠號需與 build/nginx/nginx.conf 的 proxy_pass 一致
ASPNETCORE_URLS=http://127.0.0.1:5091

# ── 外部資料庫 ────────────────────────────────────────────────────────
# 正式環境不會自動 migrate；結構以 backend/db_migration/ 腳本另行套用
# 使用只有資料讀寫權限的應用程式帳號（非 migration owner），授權方式見部署文件 4.4.3
ConnectionStrings__DefaultConnection=Host=192.168.1.20;Port=5432;Database=prod_rental;Username=rental;Password=change_this_password

# ── 登入 JWT 簽章金鑰 ─────────────────────────────────────────────────
# 至少 32 字元的隨機值（openssl rand -base64 48），每個部署各自產生並保密。
# 變更後所有已登入的 token 立即失效。
Jwt__Key=change_this_to_a_long_random_secret
Jwt__Issuer=RentalManager
Jwt__Audience=RentalManagerClient

# ── 附件儲存 ──────────────────────────────────────────────────────────
# 服務唯一可寫入的目錄（systemd ReadWritePaths）；備份時需連同資料庫一起備份
Storage__Root=/opt/RentalManager/data/uploads
Storage__MaxFileSizeMB=10

# ── 種子資料 ──────────────────────────────────────────────────────────
# 業務資料為空時，套用 backend/Seed/seed-template.json（僅 -IncludeSeed 建置時才有此檔）
SeedData__ApplyOnStartup=true

# ── Host 標頭白名單 ───────────────────────────────────────────────────────
# 對外實際網域，分號分隔多個（不含 port）。留 * 表示不限制（不建議正式環境）。
AllowedHosts=rental.example.com
