# 外部資料庫（DB 自行管理，不由本 compose 啟動）
# DB_HOST 填你資料庫的位址：
#   - DB 也在同一台 NAS 主機上（非本 compose 內）：填 NAS 的區網 IP，例如 192.168.x.x
#   - DB 在其他機器：填該機器 IP / 網域
DB_HOST=192.168.1.10
DB_PORT=5432
DB_NAME=rental_manager
DB_USER=app_user
DB_PASSWORD=change_this_password

JWT_KEY=replace-with-a-long-random-secret-key
JWT_ISSUER=RentalManager
JWT_AUDIENCE=RentalManagerClient
SEED_ON_STARTUP=true
WEB_PORT=8080
